      "email": "atlantico.operator@example.test",
      "requiredActions": []
    },
    {
      "username": "atlantico.officer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Atlantico",
      "lastName": "Officer",
      "email": "atlantico.officer@example.test",
      "requiredActions": []
    },
    {
      "username": "aurora.operator",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Aurora",
      "lastName": "Operator",
      "email": "aurora.operator@example.test",
      "requiredActions": []
    },
    {
