      "emailVerified": true,
      "firstName": "Aurora",
      "lastName": "Officer",
      "email": "aurora.officer@example.test",
      "requiredActions": []
    }
  ],
  "displayNameHtml": "<strong>Registro</strong> <span style=\"font-weight:400;opacity:.75\">Credential Authority</span>"
}
