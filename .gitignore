node_modules/
# Generated by scripts/bootstrap.sh: carries the locally minted DIDs and the
# dev Vault token. Never committed — deploy/env.example is the checked-in
# template.
deploy/.env
# Evidence captured from a run (screenshots, container digests, test output).
# The write-up in docs/evidence/01-age/ IS committed; raw artifacts are not,
# since they can contain deployment detail that is not useful in Git.
docs/evidence/01-age/artifacts/
.DS_Store
*.log

# Expo continuous native generation: services/verifier-mobile/android is
# regenerated by `expo prebuild`, so committing it invites hand edits that the
# next prebuild silently discards. Native config belongs in app.config.js and
# plugins/ instead (that is why with-openid4vp-query.js exists).
services/verifier-mobile/android/

# The vendored Paradym Wallet fork brings upstream's own .gitignore with it, and
# a nested ignore file is the right authority for that subtree: it already covers
# node_modules, the Expo prebuild output (android/, ios/), .expo/, dist/, build/,
# .env and *.keystore, and it stays correct when upstream changes it. Two things
# it never needed, because upstream's release artefacts were only ever built in
# the cloud by EAS:
vendor/paradym-wallet/**/*.apk
vendor/paradym-wallet/**/*.aab

# Local development compose overlay. Machine-specific: it names locally-built image tags and
# credential profile ids that are generated per environment and change on every stack reset.
deploy/compose.arm64.yml

# Issuer-migration rollback dumps (scripts/migrate-authority-issuer.sh)
.migrate-authority-issuer-*.sql
